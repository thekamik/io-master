# Build output of cargo.
/target/

# Packages of npm for the page of the desktop interface; made again
# from package-lock.json with `npm ci`.
/node_modules/

# The built page (`npm run build`), built into the program by cargo.
/ui/dist/

# Made by tauri-build at every build (build.rs): the schemas of the
# configuration and the permissions of the commands.
/gen/
/permissions/autogenerated/
/ui/public/pdfjs/
