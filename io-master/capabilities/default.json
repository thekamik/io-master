{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the page of the main window may do: call the commands of IO Master and nothing else (no files, no shell, no network).",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-app-state",
    "allow-set-up",
    "allow-log-in",
    "allow-log-out",
    "allow-change-password",
    "allow-ai-config",
    "allow-save-ai-connection",
    "allow-delete-ai-connection",
    "allow-activate-ai-connection",
    "allow-store-ai-key",
    "allow-delete-ai-key",
    "allow-ai-field-instruction",
    "allow-check-ai-connection",
    "allow-scan-ports",
    "allow-save-scan-settings",
    "allow-list-chats",
    "allow-open-chat",
    "allow-delete-chat",
    "allow-send-message",
    "allow-stop-reply",
    "allow-list-documents",
    "allow-load-documents",
    "allow-stop-work",
    "allow-update-document",
    "allow-delete-document",
    "allow-document-page",
    "allow-search-documents",
    "allow-document-pdf",
    "allow-list-oscal-documents",
    "allow-import-oscal-document",
    "allow-export-oscal-document",
    "allow-delete-oscal-document"
  ]
}
