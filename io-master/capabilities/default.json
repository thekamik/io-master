  "windows": [
    "main"
  ],
  "permissions": [
    "allow-app-state",
    "allow-set-up",
    "allow-log-in",
    "allow-log-out",
    "allow-change-password",
    "allow-ai-config",
    "allow-save-ai-connection",
    "allow-delete-ai-connection",
    "allow-activate-ai-connection",
    "allow-store-ai-key",
    "allow-delete-ai-key",
    "allow-ai-field-instruction",
    "allow-check-ai-connection",
    "allow-scan-ports",
    "allow-save-scan-settings",
    "allow-list-chats",
    "allow-open-chat",
    "allow-delete-chat",
    "allow-send-message",
    "allow-stop-reply",
    "allow-list-documents",
    "allow-load-documents",
    "allow-stop-work",
    "allow-update-document",
    "allow-delete-document",
    "allow-document-page",
    "allow-search-documents",
    "allow-document-pdf",
    "allow-list-oscal-documents",
    "allow-import-oscal-document",
    "allow-export-oscal-document",
    "allow-delete-oscal-document",
    "allow-create-catalog",
    "allow-open-catalog",
    "allow-add-catalog-group",
    "allow-update-catalog-group",
    "allow-add-catalog-control",
    "allow-update-catalog-control",
    "allow-delete-catalog-object",
    "allow-add-catalog-quote",
    "allow-delete-catalog-quote",
    "allow-accept-catalog-proposal",
    "allow-reject-catalog-proposal",
    "allow-catalog-instructions",
    "allow-save-catalog-instructions",
    "allow-propose-catalog-groups",
    "allow-propose-catalog-controls"
  ]
